// Rstest Snapshot v1

exports[`should allow to custom pull distance 1`] = `
<div class="van-pull-refresh">
  <div
    class="van-pull-refresh__track"
    style="transition-duration: 0ms; transform: translate3d(0,100px, 0);"
  >
    <div class="van-pull-refresh__head">
      <div class="van-pull-refresh__status">
        <i
          class="van-badge__wrapper van-icon van-icon-down van-pull-refresh__status-icon van-pull-refresh__status-icon--pulling"
          style="transform: scale(0.33);"
        >
        </i>
        <span class="van-pull-refresh__text">
          下拉刷新
        </span>
      </div>
    </div>
  </div>
</div>
`;

